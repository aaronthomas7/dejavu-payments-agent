# ---- Hindsight Cloud (memory) ----
# Sign up at https://ui.hindsight.vectorize.io, add promo code MEMHACK99 under Billing, then create an API key.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# One bank = one "brain". Change it to start with an empty memory.
HINDSIGHT_BANK_ID=dejavu-payments-desk

# ---- Groq (the model that reasons) ----
# Create a key at https://console.groq.com/keys
# Free keys have a daily token quota. You can list several keys (e.g. a teammate's) separated by commas:
# DejaVu spreads calls across them and skips a key once its daily quota is used up.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
# Groq free tier for gpt-oss-120b: 8K tokens/min, 30 requests/min (per key). Raise these on a paid tier.
LLM_TPM_LIMIT=7000
LLM_RPM_LIMIT=28

# ---- Demo helpers ----
# Pre-fills the analyst's investigation notes in the resolve dialog (presenter aid; the agent never sees them).
SHOW_DEMO_HINTS=true

# ---- Offline development (no keys needed; NOT the real product) ----
# MEMORY_BACKEND=local
# LLM_BACKEND=offline
